# Copy to server/.env and fill in.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Origin the browser uses. The Google redirect URI must be registered as
#   ${PUBLIC_URL}/api/auth/google/callback
PUBLIC_URL=http://localhost:5173
# Optional
# Set this to the same value configured in hardware/canteen_esp32.ino.
HARDWARE_API_KEY=replace-with-a-long-random-value
# PORT=4000
# DB_PATH=./data/canteen.db
# SEED_DEMO_DATA=true      # set false in production: no fake customers/orders
